<Window x:Class="WPFImageTransfer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước ảnh" Height="500" Width="700" Background="#111111">
    <Grid>
        <ScrollViewer x:Name="scrollViewer" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseLeftButtonDown="scrollViewer_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="scrollViewer_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="scrollViewer_PreviewMouseLeftButtonUp">
            <Grid Background="Transparent" MouseWheel="Image_MouseWheel">
                <Image x:Name="imgFull" Stretch="Uniform">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="imgScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
        <TextBlock Text="Cuộn chuột để Zoom - Giữ chuột trái để di chuyển" 
                   Foreground="White" Opacity="0.5" 
                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20"/>
    </Grid>
</Window>