<Window x:Class="WPFImageTransfer.AugmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Augmentation" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#202124" Foreground="#E8EAED">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#333333">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#444444">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10"/>
                                <RectangleGeometry Rect="10,10,10,10"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="THAM SỐ" Margin="0,0,0,15" FontWeight="SemiBold" Foreground="#E8EAED" FontSize="14"/>

            <CheckBox x:Name="chkFlipH" Content="Lật ngang (Flip Horizontal)" Margin="0,0,0,10" Foreground="White" Checked="SettingChanged" Unchecked="SettingChanged"/>
            <CheckBox x:Name="chkFlipV" Content="Lật dọc (Flip Vertical)" Margin="0,0,0,20" Foreground="White" Checked="SettingChanged" Unchecked="SettingChanged"/>

            <TextBlock Text="Góc xoay (Độ):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <!-- MARK: Cấu hình giới hạn góc xoay tối thiểu (-180 độ) và tối đa (180 độ) -->
                <Slider x:Name="sliderRotate" Grid.Column="0" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="15" TickFrequency="15" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                <TextBox x:Name="txtRotate" Grid.Column="1" Text="0" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>
            </Grid>

            <TextBlock Text="Kéo xiên ngang (Shear X - Độ):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <!-- MARK: Cấu hình giới hạn góc nghiêng tối thiểu (-45 độ) và tối đa (45 độ) -->
                <Slider x:Name="sliderShear" Grid.Column="0" Minimum="-45" Maximum="45" Value="0" SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                <TextBox x:Name="txtShear" Grid.Column="1" Text="0" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>
            </Grid>

            <TextBlock Text="Dịch chuyển ngang (Shift X - %):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="sliderShiftX" Grid.Column="0" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                <TextBox x:Name="txtShiftX" Grid.Column="1" Text="0" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>
            </Grid>

            <TextBlock Text="Dịch chuyển dọc (Shift Y - %):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="sliderShiftY" Grid.Column="0" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" />
                <TextBox x:Name="txtShiftY" Grid.Column="1" Text="0" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>
            </Grid>

            <TextBlock Text="Số lượng ảnh sinh ra:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="sliderCount" Grid.Column="0" Minimum="1" Maximum="2000" Value="1" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderCount_ValueChanged" />
                <TextBox x:Name="txtCount" Grid.Column="1" Text="1" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Right" VerticalAlignment="Center" KeyDown="TxtCount_KeyDown" LostFocus="TxtCount_LostFocus"/>
            </Grid>

            <Button Content="Mặc định" Click="BtnReset_Click" Height="30" Margin="0,0,0,10" Background="#3E3E42" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy" Click="BtnCancel_Click" Height="35" Width="80" Margin="0,0,10,0" Background="#666666" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                <Button Content="Áp dụng" Click="BtnApply_Click" Height="35" Width="100" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="#3F3F46" BorderThickness="2" Background="#1E1E1E">
            <Grid>
                <Image x:Name="ImgPreview" Stretch="Uniform" />
                <TextBlock x:Name="txtStatus" Text="Đang xử lý..." Foreground="White" Background="#88000000" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
