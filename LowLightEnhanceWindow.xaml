<Window x:Class="WPFImageTransfer.LowLightEnhanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tăng Cường Ảnh Thiếu Sáng &amp; So Sánh Trước / Sau (GHE / AHE / CLAHE)" Height="760" Width="1180"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#1E1E1E" Foreground="White"
        SizeChanged="Window_SizeChanged">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- BẢNG ĐIỀU KHIỂN BÊN TRÁI -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
            <StackPanel>
                <!-- 1. CHỌN THUẬT TOÁN -->
                <GroupBox Header="1. Lựa chọn thuật toán" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,12" Padding="8" BorderBrush="#3F3F46">
                    <StackPanel>
                        <RadioButton x:Name="rbCLAHE" Content="CLAHE (Cân bằng tương phản giới hạn)" IsChecked="True" 
                                     Foreground="White" Margin="0,3,0,6" Checked="Algorithm_Changed"
                                     ToolTip="Thuật toán tối ưu nhất: Tăng sáng rõ nét, chống nổ nhiễu ở vùng tối đồng nhất."/>
                        <RadioButton x:Name="rbAHE" Content="AHE (Cân bằng thích nghi theo ô)" 
                                     Foreground="White" Margin="0,0,0,6" Checked="Algorithm_Changed"
                                     ToolTip="Cân bằng thích nghi cục bộ theo ô lưới (không giới hạn ngưỡng)."/>
                        <RadioButton x:Name="rbGHE" Content="GHE (Cân bằng toàn cục)" 
                                     Foreground="White" Margin="0,0,0,3" Checked="Algorithm_Changed"
                                     ToolTip="Kéo dãn dải tương phản trên toàn bộ bức ảnh."/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. THAM SỐ TINH CHỈNH -->
                <GroupBox Header="2. Tham số tinh chỉnh" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,12" Padding="8" BorderBrush="#3F3F46">
                    <StackPanel>
                        <!-- Clip Limit -->
                        <StackPanel x:Name="panelClipLimit" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Ngưỡng cắt (Clip Limit):" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblClipLimitVal" Text="2.5" Foreground="#007ACC" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="sliderClipLimit" Minimum="0.5" Maximum="8.0" Value="2.5" SmallChange="0.1" LargeChange="0.5"
                                    TickFrequency="0.5" IsSnapToTickEnabled="False" ValueChanged="SliderClipLimit_ValueChanged"/>
                        </StackPanel>

                        <!-- Grid Size -->
                        <StackPanel x:Name="panelGridSize" Margin="0,0,0,10">
                            <TextBlock Text="Kích thước lưới ô (Tile Grid):" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbGridSize" SelectionChanged="CmbGridSize_SelectionChanged" Background="#2D2D30" Foreground="White">
                                <ComboBoxItem Content="4 x 4 (Ô lớn - Tương phản mượt)" Tag="4" Foreground="Black"/>
                                <ComboBoxItem Content="8 x 8 (Khuyến nghị - Cân đối)" Tag="8" IsSelected="True" Foreground="Black"/>
                                <ComboBoxItem Content="16 x 16 (Ô nhỏ - Chi tiết cao)" Tag="16" Foreground="Black"/>
                                <ComboBoxItem Content="32 x 32 (Siêu chi tiết)" Tag="32" Foreground="Black"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Color Space -->
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Không gian màu xử lý:" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbColorSpace" SelectionChanged="CmbColorSpace_SelectionChanged" Background="#2D2D30" Foreground="White">
                                <ComboBoxItem Content="YCrCb Luminance (Bảo toàn màu sắc)" Tag="YCrCb" IsSelected="True" Foreground="Black"/>
                                <ComboBoxItem Content="CIELab Lightness (Cảm nhận thị giác)" Tag="Lab" Foreground="Black"/>
                                <ComboBoxItem Content="Grayscale (Ảnh đơn sắc mức xám)" Tag="Grayscale" Foreground="Black"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 3. BIỂU ĐỒ HISTOGRAM -->
                <GroupBox Header="3. Phân bố biểu đồ sáng (Histogram)" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,15" Padding="8" BorderBrush="#3F3F46">
                    <StackPanel>
                        <Border BorderBrush="#3F3F46" BorderThickness="1" Background="#252526" Height="130" Margin="0,0,0,8">
                            <Canvas x:Name="cvHistogram" Width="320" Height="125" ClipToBounds="True"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="12" Height="12" Fill="#E81123" Margin="0,0,5,0"/>
                            <TextBlock Text="Ảnh gốc" Foreground="#CCCCCC" FontSize="11" Margin="0,0,15,0"/>
                            <Rectangle Width="12" Height="12" Fill="#00D0FF" Margin="0,0,5,0"/>
                            <TextBlock Text="Sau xử lý" Foreground="#CCCCCC" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="4. Đánh giá chất lượng ảnh" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,12" Padding="8" BorderBrush="#3F3F46">
                    <StackPanel>
                        <Button Content="Thêm ảnh tham chiếu (Ground Truth)" Click="BtnSelectReference_Click" Height="30" Margin="0,0,0,8" Background="#3E3E42" Foreground="White" BorderThickness="0" ToolTip="Chọn ảnh tham chiếu (chụp chuẩn đủ sáng) để đo chỉ số PSNR và SSIM"/>
                        <TextBlock x:Name="lblReferenceInfo" Text="Chưa thêm ảnh tham chiếu để so sánh" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/><ColumnDefinition Width="90"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Entropy" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblEntropy" Grid.Row="0" Grid.Column="1" Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="0" Grid.Column="2" Text="↑*" Foreground="#AAAAAA"/><TextBlock x:Name="lblEntropyNote" Grid.Row="0" Grid.Column="3" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="LOE" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblLoe" Grid.Row="1" Grid.Column="1" Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="1" Grid.Column="2" Text="↓" Foreground="#AAAAAA"/><TextBlock Grid.Row="1" Grid.Column="3" Text="Bảo toàn thứ tự sáng" Foreground="#888888" FontSize="10"/>
                            <TextBlock Grid.Row="2" Text="PSNR" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblPsnr" Grid.Row="2" Grid.Column="1" Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="2" Grid.Column="2" Text="↑" Foreground="#AAAAAA"/><TextBlock x:Name="lblPsnrNote" Grid.Row="2" Grid.Column="3" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="SSIM" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblSsim" Grid.Row="3" Grid.Column="1" Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="3" Grid.Column="2" Text="↑" Foreground="#AAAAAA"/><TextBlock x:Name="lblSsimNote" Grid.Row="3" Grid.Column="3" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Text="NIQE" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblNiqe" Grid.Row="4" Grid.Column="1" Text="Đang tính..." Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="4" Grid.Column="2" Text="↓" Foreground="#AAAAAA"/><TextBlock x:Name="lblNiqeNote" Grid.Row="4" Grid.Column="3" Text="Độ tự nhiên thống kê" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Text="BRISQUE" Foreground="White" Margin="0,2"/><TextBlock x:Name="lblBrisque" Grid.Row="5" Grid.Column="1" Text="Đang tính..." Foreground="#00D0FF" Margin="0,2"/><TextBlock Grid.Row="5" Grid.Column="2" Text="↓" Foreground="#AAAAAA"/><TextBlock x:Name="lblBrisqueNote" Grid.Row="5" Grid.Column="3" Text="Điểm chất lượng cảm nhận" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- NÚT ĐIỀU KHIỂN -->
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <Button Content="Mặc định" Click="BtnReset_Click" Height="32" Margin="0,0,5,0" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                    <Button Content="Hủy" Click="BtnCancel_Click" Height="32" Margin="5,0,5,0" Background="#666666" Foreground="White" BorderThickness="0"/>
                    <Button Content="Áp dụng" Click="BtnApply_Click" Height="32" Margin="5,0,0,0" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- KHUNG XEM TRƯỚC & SO SÁNH BÊN PHẢI -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. THANH CÔNG CỤ CHẾ ĐỘ SO SÁNH -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CHẾ ĐỘ XEM &amp; SO SÁNH:" FontWeight="Bold" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="rbModeSplit" Content="✂ Chia đôi (Split View)" IsChecked="True" Foreground="White" 
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="ViewMode_Changed" ToolTip="Kéo thanh trượt để so sánh nửa ảnh Trước và Sau"/>
                    <RadioButton x:Name="rbModeSideBySide" Content="⫼ Song song (Dual View)" Foreground="White" 
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="ViewMode_Changed" ToolTip="Xem 2 ảnh Gốc và Sau Xử Lý đặt cạnh nhau"/>
                    <RadioButton x:Name="rbModeSingle" Content="🖼 Đơn lẻ (Single View)" Foreground="White" 
                                 VerticalAlignment="Center" Checked="ViewMode_Changed" ToolTip="Xem toàn màn hình ảnh sau xử lý"/>
                </StackPanel>

                <CheckBox x:Name="cbShowOriginal" Content="Giữ xem ảnh gốc" Foreground="#FFA500" HorizontalAlignment="Right" VerticalAlignment="Center"
                          PreviewMouseDown="CbShowOriginal_PreviewMouseDown" PreviewMouseUp="CbShowOriginal_PreviewMouseUp"
                          Visibility="Collapsed"/>
            </Grid>

            <!-- 2. VÙNG HIỂN THỊ CHÍNH (CONTAINER) -->
            <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="2" Background="#141414" CornerRadius="4" ClipToBounds="True">
                <Grid x:Name="mainDisplayContainer" SizeChanged="MainDisplayContainer_SizeChanged">

                    <!-- CHẾ ĐỘ 1: CHIA ĐÔI (SPLIT VIEW) -->
                    <Grid x:Name="viewSplit" Visibility="Visible" MouseDown="SplitView_MouseDown" MouseMove="SplitView_MouseMove" MouseUp="SplitView_MouseUp">
                        <!-- Ảnh sau xử lý (Lớp nền bên phải) -->
                        <Image x:Name="imgSplitEnhanced" Stretch="Uniform" Margin="5"/>
                        
                        <!-- Ảnh gốc (Lớp trên, bị cắt tỉa bên trái) -->
                        <Image x:Name="imgSplitOriginal" Stretch="Uniform" Margin="5"/>

                        <!-- Canvas chứa đường phân cách & Thumb kéo -->
                        <Canvas x:Name="cvSplitOverlay" IsHitTestVisible="False">
                            <Line x:Name="lineDivider" X1="0" Y1="0" X2="0" Y2="500" Stroke="#FFA500" StrokeThickness="2.5" />
                            <Border x:Name="thumbDivider" Width="28" Height="28" Background="#FFA500" CornerRadius="14" BorderBrush="White" BorderThickness="1.5">
                                <TextBlock Text="◀▶" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>

                        <!-- Nhãn thông tin góc ảnh -->
                        <Border Background="#99000000" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
                            <TextBlock Text="◀ ẢNH GỐC" Foreground="#FF6B6B" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border Background="#99000000" CornerRadius="3" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                            <TextBlock Text="SAU XỬ LÝ ▶" Foreground="#00D0FF" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </Grid>

                    <!-- CHẾ ĐỘ 2: SONG SONG (SIDE-BY-SIDE DUAL VIEW) -->
                    <Grid x:Name="viewSideBySide" Visibility="Collapsed" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột 1: Ảnh gốc -->
                        <Grid Grid.Column="0">
                            <Image x:Name="imgSideOriginal" Stretch="Uniform" Margin="4"/>
                            <Border Background="#B3000000" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                                <TextBlock Text="ẢNH GỐC (TRƯỚC)" Foreground="#FF6B6B" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </Grid>

                        <Rectangle Grid.Column="1" Fill="#3F3F46"/>

                        <!-- Cột 2: Ảnh sau xử lý -->
                        <Grid Grid.Column="2">
                            <Image x:Name="imgSideEnhanced" Stretch="Uniform" Margin="4"/>
                            <Border Background="#B3000000" CornerRadius="3" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                <TextBlock Text="SAU XỬ LÝ (MỚI)" Foreground="#00D0FF" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- CHẾ ĐỘ 3: ĐƠN LẺ (SINGLE VIEW) -->
                    <Grid x:Name="viewSingle" Visibility="Collapsed">
                        <Image x:Name="imgSingleEnhanced" Stretch="Uniform" Margin="5"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- 3. THANH TRƯỢT TỈ LỆ CHIA ĐÔI (CHO SPLIT VIEW) -->
            <Grid Grid.Row="2" x:Name="panelSplitSlider" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tỉ lệ so sánh chia đôi:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Grid.Column="1" x:Name="sliderSplitRatio" Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="5"
                        TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="SliderSplitRatio_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="lblSplitPercent" Text="50%" Foreground="#FFA500" FontWeight="Bold" 
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <!-- 4. FOOTER THÔNG TIN HIỆU NĂNG -->
            <Border Grid.Row="3" Background="#252526" Margin="0,8,0,0" Padding="10,6" CornerRadius="3">
                <TextBlock x:Name="lblPerformanceInfo" Text="Độ phân giải: 0x0 | Thời gian xử lý: 0ms | Thuật toán: CLAHE" 
                           Foreground="#AAAAAA" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
