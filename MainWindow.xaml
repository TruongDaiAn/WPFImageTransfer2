<Window x:Class="WPFImageTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFImageTransfer"
        xmlns:converters="clr-namespace:WPFImageTransfer.Converters"
        mc:Ignorable="d"
        Title="ImageTransfer" Height="900" Width="1600"
        Background="#202124" Foreground="#E8EAED"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <converters:ThumbnailConverter x:Key="ThumbConverter"/>
        <DrawingBrush x:Key="CheckerboardBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#333333">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#444444">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10"/>
                                <RectangleGeometry Rect="10,10,10,10"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#292A2D" Foreground="#E8EAED" Padding="6,2">
            <MenuItem Header="File">
                <MenuItem Header="New" Foreground="Black" Click="MenuItemNew_Click" />
                <MenuItem Header="Open" Foreground="Black" Click="ButtonSelectImage_Click"/>
                <Separator Background="#444444" />
                <MenuItem Header="Exit" Foreground="Black" Click="MenuItemExit_Click"/>
            </MenuItem>
            <MenuItem Header="Xử lý ảnh">
                <MenuItem Header="Chuyển màu xám (Grayscale)" Click="ButtonGrayscale_Click" Foreground="Black"/>
                <MenuItem Header="Làm mờ (Gaussian Blur)" Click="ButtonBlurImage_Click" Foreground="Black"/>
                <MenuItem Header="Phát hiện viền (Canny Edge)" Click="ButtonCanny_Click" Foreground="Black"/>
                <MenuItem Header="Bộ lọc Cổ điển (Sepia)" Click="ButtonSepia_Click" Foreground="Black"/>
                <MenuItem Header="Chỉnh màu (Curves)" Click="ButtonCurve_Click" Foreground="Black"/>
                <Separator Background="#444444" />
                <MenuItem Header="Tạo Mask (Mặt nạ)" Foreground="Black">
                    <MenuItem Header="Mask: Hình tròn (Circle)" Click="ButtonMaskCircle_Click" Foreground="Black"/>
                    <MenuItem Header="Mask: Hình chữ nhật (Rectangle)" Click="ButtonMaskRectangle_Click" Foreground="Black"/>
                    <MenuItem Header="Mask: Từ ảnh khác (Image Alpha)" Click="ButtonMaskImage_Click" Foreground="Black"/>
                </MenuItem>
                <MenuItem Header="Chọn vùng (Selection)" Foreground="Black">
                    <MenuItem Header="Hình chữ nhật (Rectangle)" Click="ButtonSelectRect_Click" Foreground="Black"/>
                    <MenuItem Header="Hình Elip (Ellipse)" Click="ButtonSelectEllipse_Click" Foreground="Black"/>
                    <MenuItem Header="Chọn đối tượng (GrabCut)" Click="ButtonSelectObject_Click" Foreground="Black"/>
                </MenuItem>
                <MenuItem Header="Bộ lọc màu (ColorMap)" Foreground="Black">
                    <MenuItem Header="Bộ lọc: Mùa thu (Vintage/Autumn)" Click="ButtonFilterAutumn_Click" Foreground="Black"/>
                    <MenuItem Header="Bộ lọc: Mùa đông (Cold/Winter)" Click="ButtonFilterWinter_Click" Foreground="Black"/>
                    <MenuItem Header="Bộ lọc: Rực rỡ (Neon/Rainbow)" Click="ButtonFilterRainbow_Click" Foreground="Black"/>
                </MenuItem>
                <Separator Background="#444444" />
                <MenuItem Header="Xoay ảnh 90°" Click="ButtonRotate_Click" Foreground="Black"/>
                <MenuItem Header="Data Augmentation" Click="ButtonAugmentation_Click" Foreground="Black"/>
            </MenuItem>
            <MenuItem Header="Tăng cường sáng">
                <MenuItem Header="Cân bằng toàn cục (GHE)" Click="MenuItemGHE_Click" Foreground="Black" ToolTip="Cân bằng phân bố độ sáng trên toàn bộ bức ảnh"/>
                <MenuItem Header="Cân bằng thích nghi (AHE)" Click="MenuItemAHE_Click" Foreground="Black" ToolTip="Cân bằng thích nghi cục bộ theo ô lưới"/>
                <MenuItem Header="Cân bằng giới hạn tương phản (CLAHE)" Click="MenuItemCLAHE_Click" Foreground="Black" ToolTip="Tăng sáng và hạn chế nhiễu vùng tối"/>
                <Separator Background="#444444" />
                <MenuItem Header="Mở bảng tăng cường thiếu sáng..." Click="MenuItemEnhancementDialog_Click" Foreground="Black" FontWeight="Bold" ToolTip="Tinh chỉnh tham số và xem histogram trước/sau"/>
            </MenuItem>
        </Menu>
        <Grid Background="#202124">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="20" BorderBrush="#45474D" BorderThickness="1" Background="#18191B" CornerRadius="3">
                <Grid x:Name="maskOverlayContainer" SizeChanged="maskOverlayContainer_SizeChanged">
                    <ScrollViewer x:Name="scrollViewer" 
                                  HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseLeftButtonDown="scrollViewer_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="scrollViewer_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="scrollViewer_PreviewMouseLeftButtonUp">
                        <Grid Background="Transparent" MouseWheel="Image_MouseWheel">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="imgScale" ScaleX="1" ScaleY="1" />
                                </Grid.LayoutTransform>
                                <Grid x:Name="imgContainer" Background="#1E1E1E">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="imgTranslate" X="0" Y="0" />
                                    </Grid.RenderTransform>
                                    <Image x:Name="imgPreview" Stretch="Uniform" />
                                    <Canvas x:Name="selectionCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Rectangle x:Name="selectionRectangle" Stroke="Cyan" StrokeThickness="2" StrokeDashArray="4 4" Visibility="Collapsed" />
                                        <Ellipse x:Name="selectionEllipse" Stroke="Cyan" StrokeThickness="2" StrokeDashArray="4 4" Visibility="Collapsed" />
                                    </Canvas>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="txtFilePath" Text="Chưa chọn ảnh" Foreground="#666666" 
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                    <Path x:Name="discordMaskOverlay" Fill="#B3000000" IsHitTestVisible="False" Visibility="Collapsed" Stretch="None" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,20,20,20">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="ẢNH ĐANG MỞ" Foreground="#E8EAED" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="↩ Undo" Click="ButtonUndo_Click" Padding="5,2" Margin="0,0,5,0" Background="#3E3E42" Foreground="White" BorderThickness="0" ToolTip="Hoàn tác (Ctrl+Z)"/>
                        <Button Content="Redo ↪" Click="ButtonRedo_Click" Padding="5,2" Background="#3E3E42" Foreground="White" BorderThickness="0" ToolTip="Làm lại (Ctrl+Y)"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="cbApplyToAll" Content="Áp dụng cho toàn bộ danh sách" Foreground="#B8BBC2" FontWeight="Normal" Margin="0,0,5,10" ToolTip="Khi bật, các hiệu ứng sẽ được áp dụng cho toàn bộ danh sách."/>
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Thêm ảnh" Click="ButtonSelectImage_Click" Height="30" Margin="0,0,5,5" FontWeight="Bold"
                            Background="#256D9B" Foreground="White" BorderThickness="0"/>
                    <Button Content="Xóa hết" Click="ButtonRemoveImage_Click" Height="30" Margin="5,0,0,5" FontWeight="Bold"
                            Background="#4A4D52" Foreground="White" BorderThickness="0"/>
                    <Button Content="Xuất tất cả" Click="ButtonExportAll_Click" Height="30" Margin="0,0,5,5" FontWeight="Bold"
                            Background="#4A4D52" Foreground="White" BorderThickness="0" ToolTip="Xuất các ảnh trong danh sách"/>
                    <Button Content="Xem DS Chờ" Click="ButtonPreviewAll_Click" Height="30" Margin="5,0,0,5" FontWeight="Bold"
                            Background="#4A4D52" Foreground="White" BorderThickness="0"/>
                    <Button Content="Xem trước" Click="ButtonPreview_Click" Height="30" Margin="0,0,5,5" FontWeight="Bold"
                            Background="#4A4D52" Foreground="White" BorderThickness="0"/>
                    <Button Content="Lưu ảnh HT" Click="ButtonSaveImage_Click" Height="30" Margin="5,0,0,5" FontWeight="Bold"
                            Background="#256D9B" Foreground="White" BorderThickness="0"/>
                </UniformGrid>
                <Button x:Name="btnApplyMovableMask" Content="✔ Cắt theo Mask đang chọn" Click="ButtonApplyMovableMask_Click" Height="40" Margin="0,0,0,5" FontWeight="Bold" Background="#FFD700" Foreground="Black" BorderThickness="0" Visibility="Collapsed"/>
                <Button x:Name="btnCancelMovableMask" Content="✖ Huỷ Mask" Click="ButtonCancelMovableMask_Click" Height="30" Margin="0,0,0,10" FontWeight="Bold" Background="#666666" Foreground="White" BorderThickness="0" Visibility="Collapsed"/>
                <Button x:Name="btnCropSelection" Content="✔ Cắt ảnh vùng chọn" Click="ButtonCropSelection_Click" Height="40" Margin="0,0,0,5" FontWeight="Bold" Background="#00A000" Foreground="White" BorderThickness="0" Visibility="Collapsed"/>
                <Button x:Name="btnCancelSelection" Content="✖ Huỷ vùng chọn" Click="ButtonCancelSelection_Click" Height="30" Margin="0,0,0,10" FontWeight="Bold" Background="#666666" Foreground="White" BorderThickness="0" Visibility="Collapsed"/>
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Độ sáng:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Slider x:Name="sliderBrightness" Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Thumb.DragCompleted="Slider_DragCompleted" Thumb.DragStarted="Slider_DragStarted" ValueChanged="Slider_ValueChanged"/>
                    <TextBox x:Name="txtBrightness" Grid.Row="0" Grid.Column="2" Text="0" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextAlignment="Right" Width="30" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tương phản:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,5,5,0"/>
                    <Slider x:Name="sliderContrast" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="1.0" VerticalAlignment="Center" Margin="0,5,0,0" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1" IsSnapToTickEnabled="True" Thumb.DragCompleted="Slider_DragCompleted" Thumb.DragStarted="Slider_DragStarted" ValueChanged="Slider_ValueChanged"/>
                    <TextBox x:Name="txtContrast" Grid.Row="1" Grid.Column="2" Text="1.0" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,5,0,0" TextAlignment="Right" Width="30" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ mờ đục:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,5,5,0"/>
                    <Slider x:Name="sliderOpacity" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,5,0,0" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" Thumb.DragCompleted="Slider_DragCompleted" Thumb.DragStarted="Slider_DragStarted" ValueChanged="Slider_ValueChanged"/>
                    <TextBox x:Name="txtOpacity" Grid.Row="2" Grid.Column="2" Text="100" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,5,0,0" TextAlignment="Right" Width="30" KeyDown="TxtValues_KeyDown" LostFocus="TxtValues_LostFocus"/>
                </Grid>
                <ListBox x:Name="lstImages" Height="700" Background="#252526" BorderThickness="1" BorderBrush="#3F3F46"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="lstImages_SelectionChanged"
                         AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Converter={StaticResource ThumbConverter}}" Width="60" Height="45" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding}" Foreground="#CCCCCC" VerticalAlignment="Center" 
                                               FontSize="11" TextTrimming="CharacterEllipsis" Width="200"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E3E42" />
                            </Style.Resources>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>