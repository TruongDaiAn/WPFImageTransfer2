<Window x:Class="WPFImageTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFImageTransfer"
        mc:Ignorable="d"
        Title="ImageTransfer" Height="900" Width="1600">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#2D2D30" Foreground="#F1F1F1">
            <MenuItem Header="File" >
                <MenuItem Header="New" Foreground="Black" Click="MenuItemNew_Click" />
                <MenuItem Header="Open" Foreground="Black" Click="ButtonSelectImage_Click"/>
                <Separator Background="#444444" />
                <MenuItem Header="Exit" Foreground="Black" Click="MenuItemExit_Click"/>
            </MenuItem>
        </Menu>

        <Grid Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="20" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="5">
                <ScrollViewer x:Name="scrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="scrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="scrollViewer_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="scrollViewer_PreviewMouseLeftButtonUp">
                    <Grid Background="Transparent" MouseWheel="Image_MouseWheel">
                        <Image x:Name="imgPreview" Stretch="Uniform" Margin="10">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="imgScale" ScaleX="1" ScaleY="1" />
                            </Image.LayoutTransform>
                        </Image>
                        <TextBlock x:Name="txtFilePath" Text="Chưa chọn ảnh" Foreground="#666666" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,20,20,20">
                <TextBlock Text="DANH SÁCH ẢNH" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Thêm ảnh" Click="ButtonSelectImage_Click" Height="35" Margin="0,0,5,0" FontWeight="Bold"
                            Background="#007ACC" Foreground="White" BorderThickness="0"/>
                    <Button Content="Xóa hết" Click="ButtonRemoveImage_Click" Height="35" Margin="5,0,0,0" FontWeight="Bold"
                            Background="#E81123" Foreground="White" BorderThickness="0"/>
                    <Button Content="Xem trước" Click="ButtonPreview_Click" 
                            Height="40" Margin="0,0,5,0" FontWeight="Bold"
                            Background="#68217A" Foreground="White" BorderThickness="0"/>
                    <Button Content="Lưu ảnh" Click="ButtonSaveImage_Click" 
                            Height="40" Margin="5,0,0,0" FontWeight="Bold"
                            Background="#007ACC" Foreground="White" BorderThickness="0"/>
                </UniformGrid>

                <ListBox x:Name="lstImages" Height="700" Background="#252526" BorderThickness="1" BorderBrush="#3F3F46"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="lstImages_SelectionChanged"
                         AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding}" Width="60" Height="45" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding}" Foreground="#CCCCCC" VerticalAlignment="Center" 
                                               FontSize="11" TextTrimming="CharacterEllipsis" Width="200"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3E3E42" />
                            </Style.Resources>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>